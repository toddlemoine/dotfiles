export ZSH=$HOME/.oh-my-zsh

ZSH_THEME="lambda-mod"

plugins=(git zsh-completions dotenv zsh-autosuggestions history-substring-search vi-mode)

# Cache compinit — only rebuild dump once per day for faster startup
autoload -Uz compinit
for dump in ~/.zcompdump(N.mh+24); do
  compinit
done
compinit -C

ZSH_DOTENV_FILE=.env.development.local

export EDITOR=nvim

export PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH="/opt/homebrew/bin:$HOME/bin:$HOME/.rbenv/bin:$HOME/npm/bin:$PATH"
export PATH="$HOME/.local/share/nvim/site:$HOME/.local/bin:$PATH"

eval "$(/opt/homebrew/bin/brew shellenv)"

fpath+=${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions/src
source $ZSH/oh-my-zsh.sh

# *****************
# Aliases
# *****************
alias zshconfig="nvim ~/.zshrc"
alias vimconfig="nvim ~/config/init.vim"
alias icloud="cd ~/Library/Mobile\ Documents/com~apple~CloudDocs/"
alias sleepnow="pmset sleepnow"
alias ls="eza"

# Load local env vars (tokens, machine-specific config — not tracked in git)
[[ -f ~/.zshenv.local ]] && source ~/.zshenv.local

# *****************************
# NVM
# *****************************
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

# Auto-switch node version on cd when .nvmrc is present
autoload -U add-zsh-hook
load-nvmrc() {
  local node_version="$(nvm version)"
  local nvmrc_path="$(nvm_find_nvmrc)"

  if [ -n "$nvmrc_path" ]; then
    local nvmrc_node_version=$(nvm version "$(cat "${nvmrc_path}")")

    if [ "$nvmrc_node_version" = "N/A" ]; then
      nvm install
    elif [ "$nvmrc_node_version" != "$node_version" ]; then
      nvm use
    fi
  elif [ "$node_version" != "$(nvm version default)" ]; then
    echo "Reverting to nvm default version"
    nvm use default
  fi
}
add-zsh-hook chpwd load-nvmrc
load-nvmrc

